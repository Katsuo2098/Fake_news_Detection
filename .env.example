FACT_CHECK_API_URL=https://your-fact-check-api.example.com/verify
FACT_CHECK_API_KEY=replace_with_your_key

# No-key live event verification. Enabled by default for earthquake claims.
LIVE_EVENT_CHECKS=true
USGS_EARTHQUAKE_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/significant_month.geojson

# Optional no-key live news search through GDELT. Disabled by default to keep
# API responses fast and conservative.
LIVE_NEWS_CHECKS=false
LIVE_NEWS_API_URL=https://api.gdeltproject.org/api/v2/doc/doc
